# ── EchoOrchestrator environment ──────────────────────────────────────────────
# Copy to .env and fill in real values.
# Shared by all services via docker-compose.yml variable interpolation.

# ── MySQL (EchoDatabase) ─────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=echo_db
MYSQL_USER=echo_app
MYSQL_PASSWORD=change-me-app

# ── EchoWeb ──────────────────────────────────────────────────────────────────
# Browser-facing URL for media files.
# Dev:  http://localhost:18082
# Prod: https://media.echo.wisp.net   (set in docker-compose.prod.yml)
MEDIA_BASE_URL=http://localhost:18082
