# ── EchoOrchestrator environment ──────────────────────────────────────────────
# Copy to .env and fill in real values.
#
# This file carries what the *containers* need, not what the applications
# need. Each Echo app reads its own settings from `echo_tbl_Settings` in the
# Echo database — see EchoDatabase `init/009_settings.sql`, where rows are
# keyed by `sApp`: `'*'` for every app, `'web'` / `'service'` / `'media'` for
# one. Adding an app-specific setting is a row, never a new table.

# ── MySQL (EchoDatabase) ─────────────────────────────────────────────────────
# The database container configures itself from these, and the apps are told
# where to find it — a database cannot carry its own address, and everything
# else about them is a row inside it.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=echo_db
MYSQL_USER=echo_app
MYSQL_PASSWORD=change-me-app

# ── The trusted network ──────────────────────────────────────────────────────
# `trustedCIDR` is the one setting the Echo apps read from outside the Echo
# database: platform-wide network policy that identity and every application
# have to agree on, so it is spelled once — in the NocoDB base `IdentityBase`,
# table `auth_tbl_Settings`. The base is found by NAME at runtime, never by an
# ID. Generate the token in the NocoDB UI: Account → Tokens.
NOCODB_BASE_URL=http://nocodb:8080
NOCODB_API_TOKEN=generate-in-nocodb-ui
